@@ -360,3 +360,69 @@ void GXMWaitForFrameFence(uint32 SyncValue, EGXMFenceWaitSite Site = EGXMFenceWa
 
 /** Drains the per-site fence wait totals for the heartbeat. Seconds and counts, indexed by EGXMFenceWaitSite. */
 void GXMTakeFenceWaits(double OutSeconds[(int32)EGXMFenceWaitSite::Num], uint32 OutCounts[(int32)EGXMFenceWaitSite::Num]);
+
+/*-----------------------------------------------------------------------------
+	The GPU profiler: per-scene GPU timing recorded to ux0:data/gxm_gpu_*.csv. See GXMGpuProfiler.cpp.
+
+	Every hook is a no-op until a recording is running, and compiles to nothing in Shipping.
+-----------------------------------------------------------------------------*/
+
+#define GXM_GPU_PROFILER (!UE_BUILD_SHIPPING)
+
+/** The blocking spans the profiler's frame lines break out. */
+enum class EGXMGpuProfWait : uint8
+{
+	BeginScene,
+	EndScene,
+	Flip,
+	Throttle,
+	Present,
+	RenderStall,
+	EngineSleep,
+	Num
+};
+
+#if GXM_GPU_PROFILER
+
+/** Starts the writer and watcher threads. Game thread, once libgxm is up. */
+void GXMGpuProfStartup();
+
+/** Finishes any recording and tells the threads to stop. */
+void GXMGpuProfShutdown();
+
+/** RHIPushEvent / RHIPopEvent, before any scene test: the profiler names scenes by the event stack. */
+void GXMGpuProfNoteEventPushed(const TCHAR* Name);
+void GXMGpuProfNoteEventPopped();
+
+/** Immediately after sceGxmBeginScene(), from whichever path opened the scene. */
+void GXMGpuProfNoteSceneOpened(const TCHAR* What, uint32 Width, uint32 Height);
+
+/** Every draw, with the same arguments GXMNoteDrawIssued takes. */
+void GXMGpuProfNoteDraw(uint32 IndexCount, uint32 NumInstances);
+
+/** Immediately before sceGxmEndScene(). */
+void GXMGpuProfNoteSceneEnding();
+
+/** Immediately after sceGxmEndScene() and before GXMAdvanceFrameFence(), with the fence value the scene carries. */
+void GXMGpuProfNoteSceneEnded(uint32 FenceValue);
+
+/** Adds a blocking span to the current frame's line. */
+void GXMGpuProfNoteWait(EGXMGpuProfWait Kind, double Seconds);
+
+/** Once per frame from GXMReportScenesForFrame: writes the frame line, drains completions, polls triggers. */
+void GXMGpuProfEndFrame();
+
+#else
+
+inline void GXMGpuProfStartup() {}
+inline void GXMGpuProfShutdown() {}
+inline void GXMGpuProfNoteEventPushed(const TCHAR* Name) {}
+inline void GXMGpuProfNoteEventPopped() {}
+inline void GXMGpuProfNoteSceneOpened(const TCHAR* What, uint32 Width, uint32 Height) {}
+inline void GXMGpuProfNoteDraw(uint32 IndexCount, uint32 NumInstances) {}
+inline void GXMGpuProfNoteSceneEnding() {}
+inline void GXMGpuProfNoteSceneEnded(uint32 FenceValue) {}
+inline void GXMGpuProfNoteWait(EGXMGpuProfWait Kind, double Seconds) {}
+inline void GXMGpuProfEndFrame() {}
+
+#endif
